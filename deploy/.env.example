# ============ 游戏酒馆 · 部署环境变量 ============
# 复制本文件为 .env 并逐项填写：cp .env.example .env

# 你的域名（必填）。DNS 已把该域名 A/AAAA 记录解析到本机公网 IP
DOMAIN=tavern.example.com

# 证书申请通知邮箱（建议填写，Let's Encrypt 到期提醒）
ACME_EMAIL=you@example.com

# 保护「经典酒馆」（原版 SillyTavern 界面）的基础认证
# 用户名随意；密码哈希用下面命令生成（在装好 docker 的机器上执行）：
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '你的强密码'
# 把输出的 $2a$14$... 完整粘贴到 BASICAUTH_HASH（在 .env 中不需要再套引号）
BASICAUTH_USER=admin
BASICAUTH_HASH=

# ---------- 站点共享大模型（可选，三项齐全才会启用） ----------
# 任何 OpenAI 兼容接口均可（DeepSeek / Kimi / Qwen / OpenAI / 中转站…）
# Base URL 通常以 /v1 结尾；不配置时游客走本地剧本引擎，用户可在
# 门户「设置 → 模型接入」里使用自己的 API（BYOK）。
PIXEL_LLM_BASE_URL=
PIXEL_LLM_API_KEY=
PIXEL_LLM_MODEL=
