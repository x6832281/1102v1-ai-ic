{
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": {
    "beforeFiles": [
      { "source": "/", "destination": "/pixel-tavern/index.html" },
      { "source": "/robots.txt", "destination": "/api/pixel/seo?type=robots" },
      { "source": "/sitemap.xml", "destination": "/api/pixel/seo?type=sitemap" }
    ],
    "afterFiles": [],
    "fallback": []
  }
}
